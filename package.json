{
  "name": "@dsh-community/dsh-token-heatmap",
  "version": "0.1.0",
  "description": "在官方「账号与余额」页面下半部分挂一个最近 26 周的 token 用量热力图：上方显示全部会话 token 总用量，下方把 token 换算成「相当于 N 本《某某名著》」。通用设置里可切换 6 套浅色系配色。只统计 token，不折算价格。",
  "type": "module",
  "main": "lib/index.js",
  "icon": "./icon.svg",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "@deepseek-ai/dsh-client-locale": ">=0.2.0-rc.1 <0.3.0"
  },
  "engines": {
    "node": ">=18"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "token",
    "heatmap",
    "usage"
  ],
  "license": "MIT"
}